# -- Domain --
DOMAIN=api.cowiki.app
FRONTEND_URL=https://cowiki.app

# -- Database (host machine PostgreSQL) --
DATABASE_URL=postgres://cowiki:CHANGE_ME@host.docker.internal:5432/cowiki
COWIKI_DATABASE_EMBEDDING_DIMENSION=1536

# -- Server --
COWIKI_DATA_DIR=./data
COWIKI_PORT=3000

# -- LLM --
COWIKI_LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
COWIKI_LLM_MODEL=gpt-4o-mini
COWIKI_LLM_TEMPERATURE=0.3

# -- Embedder --
COWIKI_EMBEDDER_PROVIDER=openai
COWIKI_EMBEDDER_MODEL=text-embedding-3-small
COWIKI_EMBEDDER_API_KEY=sk-...
COWIKI_EMBEDDER_BASE_URL=https://api.openai.com/v1
COWIKI_EMBEDDER_DIMENSION=1536

# -- GitHub OAuth --
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=https://api.cowiki.app/api/auth/github/callback
