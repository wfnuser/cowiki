# Copy to .env.cloud and replace every change-me value before deployment.
POSTGRES_DB=cowiki
POSTGRES_USER=cowiki
POSTGRES_PASSWORD=change-me-postgres-password
# Required when running the Cloud binary/container directly. Compose derives
# the equivalent in-container URL from the three PostgreSQL values above.
DATABASE_URL=postgres://cowiki:change-me-postgres-password@localhost:5432/cowiki
COWIKI_TOKEN_PEPPER=change-me-to-at-least-32-random-bytes
GITHUB_CLIENT_ID=change-me-github-oauth-client-id
GITHUB_CLIENT_SECRET=change-me-github-oauth-client-secret
COWIKI_PUBLIC_ORIGIN=http://localhost:8787
COWIKI_BIND_ADDR=0.0.0.0:8787
RUST_LOG=cowiki_cloud=info,tower_http=info
